# ORCHESTRA local configuration
# Copy to .env (setup.py does this automatically). Keep real secrets out of Git.

# Local service ports
ORCHESTRA_WEB_PORT=3000
ORCHESTRA_API_PORT=8787
ORCHESTRA_OPEN_BROWSER=true

# Project to orchestrate. Leave blank to choose a project in the UI.
ORCHESTRA_PROJECT_PATH=
ORCHESTRA_GAME_SPEC_PATH=

# Claude Code integration
# Leave blank to use the authenticated Claude CLI session on this Mac.
CLAUDE_CLI_PATH=
CLAUDE_MODEL=
CLAUDE_MAX_CONCURRENT_AGENTS=4
CLAUDE_PERMISSION_MODE=default

# Safety limits
ORCHESTRA_REQUIRE_APPROVAL_FOR_COMMANDS=true
ORCHESTRA_ALLOW_DESTRUCTIVE_COMMANDS=false
ORCHESTRA_MAX_RETRIES=2
ORCHESTRA_TASK_TIMEOUT_SECONDS=3600

# Optional notifications
ORCHESTRA_MACOS_NOTIFICATIONS=true
ORCHESTRA_SOUND_NOTIFICATIONS=false

# Optional integrations (not required for local dashboard or agent execution)
GITHUB_TOKEN=
GITHUB_REPOSITORY=
